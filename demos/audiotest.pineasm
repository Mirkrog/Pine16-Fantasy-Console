; =========================================================
; Pine16 Chiptune Engine: "Clockwork Dungeon" (Seamless Loop)
; 
; Channels:
;   - Triangle ($#6545 / $#6546): Walking Bass
;   - Square   ($#6549 / $#6550): Lead Melody
;   - Noise    ($#6551 / $#6552): Percussion
;
; Working RAM:
;   $#7150 = Duration counter
; =========================================================

start:
    ; 1. Clear unneeded channels
    mov $#6543, #0      ; Sine off
    mov $#6544, #0
    mov $#6547, #0      ; Saw off
    mov $#6548, #0

    ; 2. Configure active channels
    mov $#6546, #0x00FF ; Triangle: Full volume
    mov $#6550, #0x408C ; Square: 25% pulse duty, Volume 140
    mov $#6552, #0x005A ; Noise: Volume 90

song_loop:
    ; =====================================================
    ; MEASURE 1: D Minor Tonic
    ; =====================================================

    ; Beat 1: Percussion hit + Lead D5 + Bass D3
    mov $#6551, #120
    mov $#6549, #587    ; Lead: D5
    mov $#6545, #147    ; Bass: D3
    mov $#7150, #2
    jsr step_tick
    mov $#6551, #0

    mov $#7150, #3
    jsr step_tick

    ; Beat 2: Bass F3
    mov $#6545, #175    ; Bass: F3
    mov $#7150, #5
    jsr step_tick

    ; Beat 3: Bass A3, Lead E5
    mov $#6549, #659    ; Lead: E5
    mov $#6545, #220    ; Bass: A3
    mov $#7150, #5
    jsr step_tick

    ; Beat 4: Bass F3, Lead F5
    mov $#6549, #698    ; Lead: F5
    mov $#6545, #175    ; Bass: F3
    mov $#7150, #5
    jsr step_tick

    ; =====================================================
    ; MEASURE 2: G Minor Subdominant
    ; =====================================================

    ; Beat 1: Percussion hit + Lead G5 + Bass G3
    mov $#6551, #120
    mov $#6549, #784    ; Lead: G5
    mov $#6545, #196    ; Bass: G3
    mov $#7150, #2
    jsr step_tick
    mov $#6551, #0

    mov $#7150, #3
    jsr step_tick

    ; Beat 2: Bass Bb3, Lead F5
    mov $#6549, #698    ; Lead: F5
    mov $#6545, #233    ; Bass: Bb3
    mov $#7150, #5
    jsr step_tick

    ; Beat 3: Bass D4, Lead E5
    mov $#6549, #659    ; Lead: E5
    mov $#6545, #294    ; Bass: D4
    mov $#7150, #5
    jsr step_tick

    ; Beat 4: Bass Bb3, Lead D5
    mov $#6549, #587    ; Lead: D5
    mov $#6545, #233    ; Bass: Bb3
    mov $#7150, #5
    jsr step_tick

    ; =====================================================
    ; MEASURE 3: A Major Dominant Tension
    ; =====================================================

    ; Beat 1: Percussion hit + Lead C#5 + Bass A3
    mov $#6551, #120
    mov $#6549, #554    ; Lead: C#5
    mov $#6545, #220    ; Bass: A3
    mov $#7150, #2
    jsr step_tick
    mov $#6551, #0

    mov $#7150, #3
    jsr step_tick

    ; Beat 2: Bass C#4, Lead D5
    mov $#6549, #587    ; Lead: D5
    mov $#6545, #277    ; Bass: C#4
    mov $#7150, #5
    jsr step_tick

    ; Beat 3: Bass E4, Lead E5
    mov $#6549, #659    ; Lead: E5
    mov $#6545, #330    ; Bass: E4
    mov $#7150, #5
    jsr step_tick

    ; Beat 4: Bass A3, Lead G5
    mov $#6549, #784    ; Lead: G5
    mov $#6545, #220    ; Bass: A3
    mov $#7150, #5
    jsr step_tick

    ; =====================================================
    ; MEASURE 4: Turnaround Cadence
    ; Prepares immediate harmonic pull back to D minor
    ; =====================================================

    ; Beat 1: Lead F5, Bass D3
    mov $#6551, #160
    mov $#6549, #698    ; Lead: F5
    mov $#6545, #147    ; Bass: D3
    mov $#7150, #2
    jsr step_tick
    mov $#6551, #0

    mov $#7150, #3
    jsr step_tick

    ; Beat 2: Lead E5, Bass F3
    mov $#6549, #659    ; Lead: E5
    mov $#6545, #175    ; Bass: F3
    mov $#7150, #5
    jsr step_tick

    ; Beat 3: Lead C#5 (leading tone), Bass G3
    mov $#6549, #554    ; Lead: C#5
    mov $#6545, #196    ; Bass: G3
    mov $#7150, #5
    jsr step_tick

    ; Beat 4: Lead E5, Bass A3 (Dominant pickup into Beat 1)
    mov $#6549, #659    ; Lead: E5
    mov $#6545, #220    ; Bass: A3
    mov $#7150, #5
    jsr step_tick

    ; Immediate jump back without muting channels
    jmp song_loop

; =========================================================
; Subroutine: step_tick
; Waits for $#7150 frames while active voices sustain.
; =========================================================
step_tick:
    await #8
    sub $#7150, #1
    jne step_tick, $#7150
    rtr