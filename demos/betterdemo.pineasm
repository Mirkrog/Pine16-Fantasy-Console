; pine16_sinewave_demo.pineasm
; An entirely new demo featuring a drifting geometric background 
; and a phase-shifted sine-wave sway for the PINE16 letters.

; =========================================================
; DATA SECTIONS
; =========================================================

; ---------------------------------------------------------
; 1. Palette ($#300 - $#315)
; ---------------------------------------------------------
; We inject this at runtime to bypass default VM clearing,
; but we keep the static definitions here for structural clarity.
.dw at 301 repeat 1 0x4228 ; BG Box Color 1
.dw at 302 repeat 1 0xC638 ; BG Box Color 2

; PINE16 letter gradient pairs (light, dark)
.dw at 303 repeat 1 0xFA94 ; P light (pink)
.dw at 304 repeat 1 0x8000 ; P dark  (deep red)
.dw at 305 repeat 1 0xFD0F ; I light (peach)
.dw at 306 repeat 1 0xA200 ; I dark  (burnt orange)
.dw at 307 repeat 1 0x7FF4 ; N light (mint)
.dw at 308 repeat 1 0x0400 ; N dark  (deep green)
.dw at 309 repeat 1 0xFFF4 ; E light (pale yellow)
.dw at 310 repeat 1 0x9240 ; E dark  (olive gold)
.dw at 311 repeat 1 0x7D1F ; 1 light (sky blue)
.dw at 312 repeat 1 0x0012 ; 1 dark  (deep navy)
.dw at 313 repeat 1 0xFA9F ; 6 light (orchid)
.dw at 314 repeat 1 0x8010 ; 6 dark  (deep purple)

; ---------------------------------------------------------
; 2. Background Geometric Tiles (Tiles 1-4)
; ---------------------------------------------------------
.dw at 1000 repeat 1 0x2222 ; Tile 1: Box Top-Left
.dw at 1001 repeat 7 0x2000
.dw at 1016 repeat 1 0x2222 ; Tile 2: Box Top-Right
.dw at 1017 repeat 7 0x0002
.dw at 1032 repeat 7 0x2000 ; Tile 3: Box Bottom-Left
.dw at 1039 repeat 1 0x2222
.dw at 1048 repeat 7 0x0002 ; Tile 4: Box Bottom-Right
.dw at 1055 repeat 1 0x2222

; ---------------------------------------------------------
; 3. Letter Tiles (Tiles 35-130)
