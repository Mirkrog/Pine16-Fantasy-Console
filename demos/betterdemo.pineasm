.dw at 1546 repeat 14 0x3333
.dw at 1560 repeat 32 0x3333 ; 36 & 37: FULL
.dw at 1592 repeat 1 0x3300 ; 38: ROUND_TR
.dw at 1593 repeat 1 0x3330
.dw at 1594 repeat 14 0x3333
