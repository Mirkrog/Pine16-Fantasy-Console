; 7. Initial Runtime Variables ($#7100+)
; ---------------------------------------------------------
.dw at 7103 repeat 1 2     ; Sine update divider

; =========================================================
; CODE SECTION
; =========================================================
start:
    ; --- INJECT THE PALETTE DYNAMICALLY ---
    ; VM clears memory on ROM load. This explicitly prevents 
    ; the VM from overwriting our colors to default black!
    mov $#301, #0x4228
    mov $#302, #0xC638
    mov $#303, #0xFA94
    mov $#304, #0x8000
    mov $#305, #0xFD0F
    mov $#306, #0xA200
    mov $#307, #0x7FF4
    mov $#308, #0x0400
    mov $#309, #0xFFF4
    mov $#310, #0x9240
    mov $#311, #0x7D1F
    mov $#312, #0x0012
    mov $#313, #0xFA9F
    mov $#314, #0x8010

main_loop:

    ; --- BACKGROUND UPDATE ---
    ; Drift X left (sub 1) and Y down (add 1)
    sub $#7101, #1
    and $#7101, #511
    add $#7102, #1
    and $#7102, #255

    ; Update Box 0 (Base X=10, Y=10)
    mov *A, $#7101
    add *A, #10
    and *A, #511
    mov *B, *A
    add *B, #8
    mov $#4545, *A
    mov $#4548, *B
    mov $#4551, *A
    mov $#4554, *B
    mov *A, $#7102
    add *A, #10
    and *A, #255
    mov *B, *A
    add *B, #8
    mov $#4546, *A
    mov $#4549, *A
    mov $#4552, *B
    mov $#4555, *B

    ; Update Box 1 (Base X=150, Y=40)
    mov *A, $#7101
    add *A, #150
    and *A, #511
    mov *B, *A
    add *B, #8
    mov $#4557, *A
    mov $#4560, *B
    mov $#4563, *A
    mov $#4566, *B
    mov *A, $#7102
    add *A, #40
    and *A, #255
    mov *B, *A
    add *B, #8
    mov $#4558, *A
    mov $#4561, *A
    mov $#4564, *B
    mov $#4567, *B

    ; Update Box 2 (Base X=280, Y=80)
    mov *A, $#7101
    add *A, #280
    and *A, #511
    mov *B, *A
    add *B, #8
    mov $#4569, *A
    mov $#4572, *B
    mov $#4575, *A
    mov $#4578, *B
    mov *A, $#7102
    add *A, #80
    and *A, #255
    mov *B, *A
    add *B, #8
    mov $#4570, *A
    mov $#4573, *A
    mov $#4576, *B
    mov $#4579, *B

    ; Update Box 3 (Base X=60, Y=120)
    mov *A, $#7101
    add *A, #60
    and *A, #511
    mov *B, *A
    add *B, #8
    mov $#4581, *A
    mov $#4584, *B
    mov $#4587, *A
    mov $#4590, *B
    mov *A, $#7102
    add *A, #120
    and *A, #255
    mov *B, *A
    add *B, #8
    mov $#4582, *A
    mov $#4585, *A
    mov $#4588, *B
    mov $#4591, *B

    ; Update Box 4 (Base X=200, Y=160)
    mov *A, $#7101
    add *A, #200
    and *A, #511
    mov *B, *A
    add *B, #8
    mov $#4593, *A
    mov $#4596, *B
    mov $#4599, *A
    mov $#4602, *B
    mov *A, $#7102
    add *A, #160
    and *A, #255
    mov *B, *A
    add *B, #8
    mov $#4594, *A
    mov $#4597, *A
    mov $#4600, *B
    mov $#4603, *B

    ; Update Box 5 (Base X=100, Y=190)
    mov *A, $#7101
    add *A, #100
    and *A, #511
    mov *B, *A
    add *B, #8
    mov $#4605, *A
    mov $#4608, *B
    mov $#4611, *A
    mov $#4614, *B
    mov *A, $#7102
    add *A, #190
    and *A, #255
    mov *B, *A
    add *B, #8
    mov $#4606, *A
    mov $#4609, *A
    mov $#4612, *B
    mov $#4615, *B

    ; Update Box 6 (Base X=250, Y=10)
    mov *A, $#7101
    add *A, #250
    and *A, #511
    mov *B, *A
    add *B, #8
    mov $#4617, *A
    mov $#4620, *B
    mov $#4623, *A
    mov $#4626, *B
    mov *A, $#7102
    add *A, #10
    and *A, #255
    mov *B, *A
    add *B, #8
    mov $#4618, *A
    mov $#4621, *A
    mov $#4624, *B
    mov $#4627, *B

    ; Update Box 7 (Base X=20, Y=150)
    mov *A, $#7101
    add *A, #20
    and *A, #511
    mov *B, *A
    add *B, #8
    mov $#4629, *A
    mov $#4632, *B
    mov $#4635, *A
    mov $#4638, *B
    mov *A, $#7102
    add *A, #150
    and *A, #255
    mov *B, *A
    add *B, #8
    mov $#4630, *A
    mov $#4633, *A
    mov $#4636, *B
    mov $#4639, *B

    ; Update Box 8 (Base X=300, Y=130)
    mov *A, $#7101
    add *A, #300
    and *A, #511
    mov *B, *A
    add *B, #8
    mov $#4641, *A
    mov $#4644, *B
    mov $#4647, *A
    mov $#4650, *B
    mov *A, $#7102
    add *A, #130
    and *A, #255
    mov *B, *A
    add *B, #8
    mov $#4642, *A
    mov $#4645, *A
    mov $#4648, *B
    mov $#4651, *B

    ; Update Box 9 (Base X=130, Y=90)
    mov *A, $#7101
    add *A, #130
    and *A, #511
    mov *B, *A
    add *B, #8
    mov $#4653, *A
    mov $#4656, *B
    mov $#4659, *A
    mov $#4662, *B
    mov *A, $#7102
    add *A, #90
    and *A, #255
    mov *B, *A
    add *B, #8
    mov $#4654, *A
    mov $#4657, *A
    mov $#4660, *B
    mov $#4663, *B

    ; --- SINE WAVE UPDATE (Global Timer) ---
    sub $#7103, #1
    jne update_letters, $#7103
    mov $#7103, #2
    add $#7100, #1
    and $#7100, #31

update_letters:
    ; --- Letter 0 ('P') Sway ---
    ; Phase = Timer + 0
    mov *A, $#7100
    add *A, #7000
    mov *B, $*A
    sub *B, #40
    add *B, #84
    ; Apply to 16 sprite Y-coords
