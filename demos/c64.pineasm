; ---------------------------------------------------------
; 3. Draw the boot text onto the background layer
;    Background map is 40 cols x 25 rows starting at $#3560.
;    Address = 3560 + row*40 + col
; ---------------------------------------------------------

; Row 1: "    **** COMMODORE 64 BASIC V2 ****"
mov $#3604 #1
mov $#3605 #1
mov $#3606 #1
mov $#3607 #1
mov $#3609 #2
mov $#3610 #3
mov $#3611 #4
mov $#3612 #4
