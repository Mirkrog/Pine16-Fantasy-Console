mov $#1033 #0x1000
mov $#1034 #0x0100
mov $#1035 #0x0100
mov $#1036 #0x0100
mov $#1037 #0x0100
mov $#1038 #0x0100
mov $#1039 #0x0100
mov $#1040 #0x0100
mov $#1041 #0x0100
mov $#1042 #0x0100
mov $#1043 #0x0100
mov $#1044 #0x0011
mov $#1045 #0x1000

; --- Tile 4: 'M' ---
mov $#1048 #0x0100
mov $#1049 #0x0100
mov $#1050 #0x0110
mov $#1051 #0x1100
mov $#1052 #0x0101
mov $#1053 #0x0100
mov $#1054 #0x0100
mov $#1055 #0x0100
mov $#1056 #0x0100
mov $#1057 #0x0100
mov $#1058 #0x0100
mov $#1059 #0x0100
mov $#1060 #0x0100
mov $#1061 #0x0100

; --- Tile 5: 'D' ---
