; ---------------------------------------------------------
; 3. Draw the boot text onto the background layer
;    Background map is 40 cols x 25 rows starting at $#3544.
;    Address = 3560 + row*40 + col
; ---------------------------------------------------------

; Row 1: "    **** COMMODORE 64 BASIC V2 ****"
mov $#3588 #1
mov $#3589 #1
mov $#3590 #1
mov $#3591 #1
mov $#3593 #2
mov $#3594 #3
mov $#3595 #4
mov $#3596 #4
mov $#3597 #3
mov $#3598 #5
mov $#3599 #3
mov $#3600 #6
mov $#3601 #7
