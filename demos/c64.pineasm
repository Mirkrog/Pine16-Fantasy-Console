mov $#3699 #23
mov $#3700 #6
mov $#3701 #7
mov $#3702 #7

; Row 5: "READY."
mov $#3744 #6
mov $#3745 #7
mov $#3746 #11
mov $#3747 #5
mov $#3748 #17
mov $#3749 #24

; ---------------------------------------------------------
; 4. Blink the cursor on row 6, forever
;    (the delay loops are plain mov/sub/jne so they naturally
;    span several real render frames instead of blocking one)
; ---------------------------------------------------------
blink_loop:
mov $#3784 #25
mov *C #1600
delay_on:
mov *D #65535
delay_on_inner:
sub *D #1
jne delay_on_inner *D
sub *C #1
jne delay_on *C

mov $#3784 #0
mov *C #1600
delay_off:
mov *D #65535
delay_off_inner:
sub *D #1
jne delay_off_inner *D
sub *C #1
jne delay_off *C

jmp blink_loop
