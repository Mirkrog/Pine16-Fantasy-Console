mov $#1054 #0x0100
mov $#1055 #0x0100
mov $#1056 #0x0100
mov $#1057 #0x0100
mov $#1058 #0x0100
mov $#1059 #0x0100
mov $#1060 #0x0011
mov $#1061 #0x1000

; --- Tile 4: 'M' ---
mov $#1064 #0x0100
mov $#1065 #0x0100
mov $#1066 #0x0110
mov $#1067 #0x1100
mov $#1068 #0x0101
mov $#1069 #0x0100
mov $#1070 #0x0100
mov $#1071 #0x0100
mov $#1072 #0x0100
mov $#1073 #0x0100
mov $#1074 #0x0100
mov $#1075 #0x0100
