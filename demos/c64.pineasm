mov $#1033 #0x1100
mov $#1034 #0x0100
mov $#1036 #0x0100
mov $#1038 #0x0100
mov $#1040 #0x0100
mov $#1042 #0x0100
mov $#1044 #0x0011
mov $#1045 #0x1100

; --- Tile 3: 'O' ---
