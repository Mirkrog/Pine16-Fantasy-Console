; Row 5: "READY."
mov $#3760 #6
mov $#3761 #7
mov $#3762 #11
mov $#3763 #5
mov $#3764 #17
mov $#3765 #24

; ---------------------------------------------------------
; 4. Blink the cursor on row 6, forever
;    (the delay loops are plain mov/sub/jne so they naturally
;    span several real render frames instead of blocking one)
; ---------------------------------------------------------
blink_loop:
mov $#3800 #25
mov *C #1600
delay_on:
mov *D #65535
delay_on_inner:
sub *D #1
jne delay_on_inner *D
sub *C #1
jne delay_on *C

mov $#3800 #0
mov *C #1600
delay_off:
mov *D #65535
delay_off_inner:
sub *D #1
jne delay_off_inner *D
sub *C #1
jne delay_off *C

jmp blink_loop
