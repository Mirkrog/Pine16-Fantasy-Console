mov $#1268 #0x0001

; --- Tile 18: 'T' ---
mov $#1272 #0x0111
mov $#1273 #0x1100
mov $#1274 #0x0001
mov $#1276 #0x0001
mov $#1278 #0x0001
mov $#1280 #0x0001
mov $#1282 #0x0001
mov $#1284 #0x0001

; --- Tile 19: '3' ---
mov $#1288 #0x0011
mov $#1289 #0x1000
