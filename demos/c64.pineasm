; --- Tile 20: '8' ---
mov $#1304 #0x0011
mov $#1305 #0x1000
mov $#1306 #0x0100
mov $#1307 #0x0100
mov $#1308 #0x0100
mov $#1309 #0x0100
mov $#1310 #0x0011
mov $#1311 #0x1000
mov $#1312 #0x0100
mov $#1313 #0x0100
mov $#1314 #0x0100
mov $#1315 #0x0100
mov $#1316 #0x0011
mov $#1317 #0x1000

; --- Tile 21: '9' ---
mov $#1320 #0x0011
mov $#1321 #0x1000
mov $#1322 #0x0100
