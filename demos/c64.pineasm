; c64_boot.pineasm
; Recreates the classic Commodore 64 startup screen:
;
;         **** COMMODORE 64 BASIC V2 ****
;
;          64K RAM SYSTEM  38911 BASIC BYTES FREE
;
;         READY.
;         _  <- blinking cursor
;
; ---------------------------------------------------------
; 1. Palette: C64 blue screen + light-blue text
; ---------------------------------------------------------
mov $#300 #0x421B  ; border/background: C64 blue
mov $#301 #0x9CDF  ; colour 1 (ink): C64 light blue

; ---------------------------------------------------------
; 2. Font tiles (8x8 pixels, 4bpp, single ink colour each)
;    Tile N lives at tilesheet word 1000 + 16*N.
;
;    Legend: 1=* 2=C 3=O 4=M 5=D 6=R 7=E 8=6 9=4 10=B 11=A
;            12=S 13=I 14=V 15=2 16=K 17=Y 18=T 19=3 20=8
;            21=9 22=1 23=F 24=. 25=cursor block
; ---------------------------------------------------------

; --- Tile 1: '*' ---
mov $#1016 #0x0001
mov $#1018 #0x0101
mov $#1019 #0x0100
mov $#1020 #0x0011
mov $#1021 #0x1000
mov $#1022 #0x0111
mov $#1023 #0x1100
mov $#1024 #0x0011
mov $#1025 #0x1000
mov $#1026 #0x0101
mov $#1027 #0x0100
mov $#1028 #0x0001

; --- Tile 2: 'C' ---
