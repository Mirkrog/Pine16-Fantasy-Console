; test.v16.asm
; Corrected test file matching PINE16 parser requirements

; =========================================
; DATA SECTIONS
; =========================================

; Test 1: Define a word with an explicit repeat count and address
; Sets address 400 to value 42
.dw at 400 repeat 1 42

; Test 2: Repeat value 15 across 5 addresses starting at 401
.dw at 401 repeat 5 15

; Test 3: Sprite row at address 500
; Exactly 8 palette values (0-15) packed into two 16-bit words
.dsprrow at 500 repeat 1 1, 2, 3, 4, 5, 6, 7, 8

; =========================================
; CODE SECTION
; =========================================
start:
    ; 1. Direct memory read requires '$#' prefix
    mov *A, $#400      ; Read memory at 400 into Register A

    ; 2. Immediate arithmetic requires '#' prefix
    add *A, #10        ; A = 42 + 10 = 52

    ; 3. Direct memory write requires '$#' prefix
    mov $#350, *A      ; Write 52 to memory at 350

    ; 4. Register-pointed memory read requires '$*' prefix
    mov *B, #500       ; Load base address into B
    mov *C, $*B        ; Read memory pointed to by Register B into C

    ; 5. Stack operations
    push *C
    pop *D

loop:
    jmp loop