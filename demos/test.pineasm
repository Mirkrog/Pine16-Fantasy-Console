.sprrow   1, 2, 3, 4, 5, 6, 7, 8
init_tile:
    ; A tile requires 16 words. Tile ID 1 starts at address 1016 (1000 + 1 * 16).
    ; We will fill it with 0x1111 (4369 in decimal), which represents 4 pixels 
    ; of Color Palette Index 1 per word.
    mov *C #1016          ; Register C holds the current memory address
fill_tile_loop:
    mov $*C #0xAFAF ; Write 4 pixels of Color 1 to the current address
    add *C #1             ; Move to the next word
    
    ; Check if we have written all 16 words (1016 + 16 = 1032)
    mov *D *C
    sub *D #1032
    jne fill_tile_loop *D ; If *D is not 0 (we haven't reached 1032), loop back

init_sprite:
    ; Configure Sprite 0 (Addresses 4560, 4561, 4562)
    mov $#4560 #1         ; Set Sprite 0 to use Tile ID 1 (no flip flags)
    mov $#4562 #96        ; Set Y position to 96 (Center of the 200px high screen)
    mov *A #0             ; Register A will act as our X coordinate counter

main_loop:
    await #8              ; Wait for the Vblank flag (Address 8) to clear to 0
                          ; This syncs our loop to the 30 FPS rendering rate
    
    mov $#4561 *A         ; Write Register A to Sprite 0's X position
    add *A #1             ; Move the sprite 1 pixel to the right
    
    ; Check if the sprite has moved off the right edge of the screen (X = 320)
    mov *B *A
    sub *B #320
    jeq reset_x *B        ; If *B is 0 (meaning X == 320), jump to reset_x

    jmp main_loop         ; Otherwise, continue the animation

reset_x:
    mov *A #0             ; Reset X coordinate to 0
    jmp main_loop         ; Jump back into the animation loop