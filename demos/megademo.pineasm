mov $#4927 *C
mov $#4939 *C
mov *C *B
add *C #264
mov $#4906 *C
mov $#4918 *C
mov $#4930 *C
mov $#4942 *C
mov *C *B
add *C #272
mov $#4909 *C
mov $#4921 *C
mov $#4933 *C
mov $#4945 *C
mov *C *B
add *C #280
mov $#4912 *C
mov $#4924 *C
mov $#4936 *C
mov $#4948 *C

; --- scroll the bottom message left by one cell every 6 frames ---
sub $#7210 #1
jne skip_scroll $#7210
mov $#7210 #6

mov *A #6520
mov *D #39
shift_scroll:
mov *C *A
add *C #1
mov *B $*C
mov $*A *B
add *A #1
sub *D #1
jne shift_scroll *D

add $#7200 #1
mov *A $#7200
sub *A #66
jeq reset_ptr *A
jmp ptr_ready
reset_ptr:
mov $#7200 #0
ptr_ready:

mov *A $#7200
add *A #7100
mov *B $*A
mov $#6559 *B

skip_scroll:

; --- alien ship: hidden most of the time, flies across every
;     once in a while (4 tiles moving together), with a randomised
;     altitude, speed and direction picked fresh each flight ---

; drift the y baseline along with the shared starfield heading too,
; so the ship rides the same "current" as everything else
add $#7602 $#7502

; wobble it gently up/down as it goes, around this flight's y
; baseline (reuses the logo's sine table with its own phase)
add $#7305 #3
and $#7305 #15
mov *A $#7305
add *A #7000
mov *B $*A
mov *C *B
add *C $#7602
mov $#4952 *C
mov $#4955 *C
mov *D *C
add *D #8
mov $#4958 *D
mov $#4961 *D

mov *A $#7300
jeq ship_inactive *A

; active: advance by this flight's signed x delta plus the shared
; starfield heading, and derive the right-hand tiles' x from the left
add $#4951 $#7601
add $#4951 $#7501
mov $#4957 $#4951
mov *A $#4951
add *A #8
mov $#4954 *A
mov $#4960 *A

; --- only hide the ship once it has actually left the screen
;     (direction-aware check), not on a fixed timer -- the shared
;     heading can slow its net motion, so a blind countdown could
;     hide it while it's still visible. A generous frame-count
;     fallback is kept just in case the heading ever stalls it
;     for a very long time. ---
mov *A $#7601
and *A #0x8000
jne ship_check_rtl *A

mov *A $#4951
sub *A #320
and *A #0x8000
jeq ship_hide *A
jmp ship_check_timeout

ship_check_rtl:
mov *A $#4951
and *A #0x8000
jne ship_hide *A

ship_check_timeout:
sub $#7301 #1
jne ship_state_done $#7301

ship_hide:
mov $#4950 #0
mov $#4953 #0
mov $#4956 #0
mov $#4959 #0
mov $#7300 #0
mov $#7302 #300
jmp ship_state_done

ship_inactive:
sub $#7302 #1
jne ship_state_done $#7302

; --- roll new stats for this flight via a tiny LCG
;     (seed = seed*25173+13849) ---
mul $#7600 #25173
add $#7600 #13849

mov *A $#7600
div *A #2
and *A #31
mul *A #4
add *A #15
mov $#7602 *A          ; y baseline: 15-139

mov *A $#7600
div *A #64
and *A #3
add *A #4
mov $#7601 *A          ; speed magnitude: 4-7

mov *A $#7600
and *A #1
jeq ship_dir_ltr *A

; right-to-left: start past the right edge, x delta goes negative
mov $#4951 #300
mov $#4957 #300
mov $#4954 #308
mov $#4960 #308
mov *B #0
sub *B $#7601
mov $#7601 *B
jmp ship_dir_done

ship_dir_ltr:
mov $#4951 #0
mov $#4957 #0
mov $#4954 #8
mov $#4960 #8

ship_dir_done:
mov $#7300 #1
mov $#4950 #30
mov $#4953 #31
mov $#4956 #32
mov $#4959 #33
mov $#7301 #250

ship_state_done:

; wait for the next real frame, then do it all again
await #8
jmp main_loop
