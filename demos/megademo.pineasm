; ---------------------------------------------------------
; 5. Sine table: 16 samples of one full sine wave, amplitude 0-8.
;    Shared by the logo bounce, the ship's wobble, and the
;    starfield heading (read a quarter phase apart as a crude
;    cos/sin pair, and re-centred with "- 4" where a signed value
;    is needed).
; ---------------------------------------------------------
mov $#7000 #4
mov $#7001 #6
mov $#7002 #7
mov $#7003 #8
mov $#7004 #8
mov $#7005 #8
mov $#7006 #7
mov $#7007 #6
mov $#7008 #4
mov $#7009 #2
mov $#7010 #1
; $#7011, $#7012, $#7013 are 0 (default)
mov $#7014 #1
mov $#7015 #2

; --- shared starfield heading: one drift vector for the whole
;     field, so all stars move together like flying through space.
;     vx/vy are read off the existing 16-step sine table a quarter
;     phase apart (like cos/sin of the same angle), so as the angle
;     slowly rotates, (vx,vy) traces a roughly constant-radius
;     circle -- constant speed, continuously and smoothly turning,
;     like a ship gently banking, never snapping or slowing down ---
mov $#7501 #0          ; current heading vx
mov $#7502 #4          ; current heading vy
mov $#7510 #0          ; heading angle (0-15)
mov $#7511 #70         ; frames between each 1-step angle turn (~2-3s)

; $#7020 = animation phase (0-15), starts at 0 (default)

; ---------------------------------------------------------
; 6. Main loop
; ---------------------------------------------------------
main_loop:

; advance the shared bounce phase
add $#7020 #1
and $#7020 #15

; --- slowly rotate the heading angle, then read the (constant
;     amplitude) vx/vy off the sine table a quarter phase apart ---
sub $#7511 #1
jne heading_apply $#7511
mov $#7511 #10
add $#7510 #1
and $#7510 #15

heading_apply:
mov *A $#7510
add *A #7000
mov *B $*A
sub *B #4
mov $#7501 *B

mov *A $#7510
add *A #4
and *A #15
