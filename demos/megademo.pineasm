; megademo.pineasm
; A little 90s-style demo intro:
;   - a two-shade grey parallax starfield on a black background,
;     all moving together at a constant speed while the shared
;     flight direction slowly and smoothly banks around (a rotating
;     heading read off the sine table a quarter phase apart, rather
;     than a per-star velocity, so it reads as one field of stars
;     rather than a swarm of independent marbles)
;   - a big 32x32 bold "bubble" MIRKROG logo, each letter its own
;     hue with a real light-to-dark gradient (with a dithered
;     transition band, not a hard split) and softened corners,
;     bouncing/orbiting gently on its own phase-staggered wave
;   - a classic scrolling greetings message along the bottom
;   - an alien saucer that appears every once in a while at a
;     randomised altitude, speed and direction, wobbles as it flies,
;     drifts along with the shared starfield heading, and is only
;     hidden once it has actually left the screen
;
; Paced with AWAIT on the VBLANK flag ($#8) so one pass of main_loop
; runs exactly once per real rendered frame, no matter how fast the
; host machine executes instructions.

; ---------------------------------------------------------
; 1. Palette (only 15 usable colour slots exist, so several
;    elements below deliberately share colours)
; ---------------------------------------------------------
mov $#300 #0x0000  ; background: black

; colours 1-2: star shades (far = dim, near = bright)
mov $#301 #0x4228
mov $#302 #0xC638

; colours 3-14: MIRKROG letter gradients, (light, dark) per hue.
; The scroll text and the alien ship reuse colour 2 (bright grey),
; colour 7 (pale yellow, for the ship's glass) and colour 10 (deep
; green, for the ship's alien) rather than getting dedicated slots.
mov $#303 #0xFA94  ; M light (pink)
mov $#304 #0x8000  ; M dark  (deep red)
mov $#305 #0xFD0F  ; I light (peach)
mov $#306 #0xA200  ; I dark  (burnt orange)
mov $#307 #0xFFF4  ; R light (pale yellow)
mov $#308 #0x9240  ; R dark  (olive gold)
mov $#309 #0x7FF4  ; K light (mint)
mov $#310 #0x0400  ; K dark  (deep green)
mov $#311 #0x7D1F  ; O light (sky blue)
mov $#312 #0x0012  ; O dark  (deep navy)
mov $#313 #0xFA9F  ; G light (orchid)
mov $#314 #0x8010  ; G dark  (deep purple)

; ---------------------------------------------------------
; 2. Font tiles (8x8, 4bpp). Tile N lives at word 1000 + 16*(N-1).
;
;    8      far star  (tiny dot,  grey 1)
;    11     near star (small plus, grey 2)
;    14-29  scroll-text font (grey 2): M I R K O G P E S N T H C 1 6 *
;    30-33  alien ship (16x16, 4 tiles: TL TR BL BR)
;    34-145 MIRKROG logo (32x32 per letter, 16 tiles each)
; ---------------------------------------------------------

