mov $#2401 #0x0001

; 'X' (ASCII 88)
mov $#2408 #0x1000
mov $#2409 #0x0001
mov $#2410 #0x0100
mov $#2411 #0x0100
mov $#2412 #0x0010
mov $#2413 #0x1000
mov $#2414 #0x0100
mov $#2415 #0x0100
mov $#2416 #0x1000
mov $#2417 #0x0001

; 'Y' (ASCII 89)
mov $#2424 #0x1000
mov $#2425 #0x0001
mov $#2426 #0x0100
mov $#2427 #0x0100
mov $#2428 #0x0010
mov $#2429 #0x1000
mov $#2430 #0x0010
mov $#2431 #0x0000
mov $#2432 #0x0010
mov $#2433 #0x0000

; 'Z' (ASCII 90)
mov $#2440 #0x0111
mov $#2441 #0x1110
mov $#2442 #0x0000
mov $#2443 #0x0100
mov $#2444 #0x0010
mov $#2445 #0x0000
mov $#2446 #0x0100
mov $#2447 #0x0000
mov $#2448 #0x0111
mov $#2449 #0x1110

; --- Lowercase Fallback Loop (Copy 'A'-'Z' to 'a'-'z' using A, B, C, D) ---
mov *C #0 ; Outer index (0 to 25)

lowercase_outer_loop:

; Calculate destination tile address in *A: 1000 + (('a' + *C) * 16)
mov *A *C
add *A #97
mul *A #16
add *A #1000

; Calculate source tile address in *B: 1000 + (('A' + *C) * 16)
mov *B *C
add *B #65
mul *B #16
add *B #1000

; Copy 10 words per tile
mov *D #10
copy_word_loop:
mov $*A $*B
add *A #1
add *B #1
sub *D #1
jne copy_word_loop *D

; Advance outer loop
add *C #1
mov *D *C
sub *D #26
jne lowercase_outer_loop *D

; ---------------------------------------------------------
; 3. TERMINAL & CURSOR STATE INITIALIZATION
; ---------------------------------------------------------
mov $#6656 #3560   ; Cursor position pointer
mov $#6657 #0      ; Debounce state
mov $#6658 #0      ; Blink frame counter
mov $#6659 #1      ; Cursor visibility (1 = ON, 0 = OFF)

; ---------------------------------------------------------
; 4. MAIN TERMINAL LOOP WITH BACKSPACE
; ---------------------------------------------------------
main_loop:

; --- CURSOR BLINK LOGIC ---
mov *A $#6658
add *A #1
mov $#6658 *A

; Toggle cursor every 100 iterations (~500 ms at 2 MHz)
mov *B *A
sub *B #100
jne check_input *B

; Reset counter to 0
mov $#6658 #0

; Toggle visibility flag ($#6659 = 1 - $#6659)
mov *A #1
sub *A $#6659
mov $#6659 *A

; Render or erase cursor tile (#1 = Solid Block, #32 = Space)
mov *B $#6656
jeq hide_cursor *A
mov $*B #1
jmp check_input

hide_cursor:
mov $*B #32

; --- INPUT PROCESSING ---
check_input:

mov *A $#9        ; Read active ASCII key
mov *B $#6657     ; Read previous key
mov $#6657 *A     ; Update key state tracking

jeq key_released *A

; Debounce check (Ignore if key held down)
mov *C *A
sub *C *B
jeq loop_wait *C

; --- NEW KEYPRESS DETECTED ---

; Clear active cursor slot back to space before processing
mov *B $#6656
mov $*B #32

; Check for BACKSPACE key (ASCII 8)
mov *C *A
sub *C #8
jeq handle_backspace *C

; Check for ENTER key (ASCII 13 or 10)
mov *C *A
sub *C #13
jeq handle_enter *C

mov *C *A
sub *C #10
jeq handle_enter *C

; --- PRINT STANDARD CHARACTER ---
mov *B $#6656
mov $*B *A
add *B #1
mov $#6656 *B
jmp reset_cursor_blink

; --- HANDLE BACKSPACE ---
handle_backspace:
mov *B $#6656

; Guard: Check if cursor is already at the start of tilemap ($#3560)
mov *C *B
sub *C #3560
jeq reset_cursor_blink *C   ; Don't move back if at (0, 0)

; Move cursor back by 1 tile & erase character with Space (#32)
sub *B #1
mov $#6656 *B
mov $*B #32
jmp reset_cursor_blink

; --- HANDLE ENTER KEY ---
handle_enter:
mov *B $#6656
sub *B #3560       ; Offset relative to start of map

; Calculate tiles to complete current row: 40 - (offset % 40)
mov *C *B
div *C #40
mul *C #40
add *C #40
sub *C *B

; Advance cursor to start of next line
mov *B $#6656
add *B *C
mov $#6656 *B

reset_cursor_blink:
; Force cursor visible on current spot immediately
mov $#6658 #0
mov $#6659 #1
mov *B $#6656
mov $*B #1
jmp loop_wait

key_released:
mov $#6657 #0

loop_wait:
; Stall 10,000 cycles = 5ms delay at 2 MHz
mov *B #100
stall_loop:
stall #10000
sub *B #1
jne stall_loop *B
jmp main_loop