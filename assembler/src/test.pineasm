; ascii_full_charset.asm
; Populates complete ASCII glyph dataset into tile memory ($1000 + ASCII * 16)
; Strictly using registers *A, *B, *C, and *D

; ---------------------------------------------------------
; 1. PALETTE SETUP
; ---------------------------------------------------------
mov $#300 #0x0000 ; Color 0: Black (Background)
mov $#301 #0xFFFF ; Color 1: White (Text)

; ---------------------------------------------------------
; 2. DEFINE FULL ASCII CHARSET (Tile Address = 1000 + ASCII * 16)
; ---------------------------------------------------------

; --- Space (' ', ASCII 32 -> Address 1512) ---
mov *A #1512
mov *B #16
clear_space:
mov $*A #0
add *A #1
sub *B #1
jne clear_space *B

; ---------------------------------------------------------
; DEFINE CURSOR TILE (Tile ID 1 -> 7 Pixels Wide)
; ---------------------------------------------------------
mov $#1016 #0x1111 ; Row 0: Pixels 0-3
mov $#1017 #0x1110 ; Row 0: Pixels 4-6 active, Pixel 7 transparent
mov $#1018 #0x1111 ; Row 1
mov $#1019 #0x1110
mov $#1020 #0x1111 ; Row 2
mov $#1021 #0x1110
mov $#1022 #0x1111 ; Row 3
mov $#1023 #0x1110
mov $#1024 #0x1111 ; Row 4
mov $#1025 #0x1110
mov $#1026 #0x1111 ; Row 5
mov $#1027 #0x1110
mov $#1028 #0x1111 ; Row 6
mov $#1029 #0x1110
mov $#1030 #0x1111 ; Row 7
mov $#1031 #0x1110

; --- Exclamation ('!', ASCII 33 -> Address 1528) ---
mov $#1528 #0x0100
mov $#1529 #0x0000
mov $#1530 #0x0100
mov $#1531 #0x0000
mov $#1532 #0x0100
mov $#1533 #0x0000
mov $#1534 #0x0100
mov $#1535 #0x0000
mov $#1536 #0x0000
mov $#1537 #0x0000
mov $#1538 #0x0100
mov $#1539 #0x0000

; --- Numbers: '0' to '9' (ASCII 48 - 57 -> Addresses 1768 - 1912) ---

; '0' (ASCII 48)
mov $#1768 #0x0111
mov $#1769 #0x1110
mov $#1770 #0x0100
mov $#1771 #0x0010
mov $#1772 #0x0100
mov $#1773 #0x0010
