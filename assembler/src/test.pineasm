; 'J' (ASCII 74)
mov $#2184 #0x0000
mov $#2185 #0x0010
mov $#2186 #0x0000
mov $#2187 #0x0010
mov $#2188 #0x0000
mov $#2189 #0x0010
mov $#2190 #0x0100
mov $#2191 #0x0010
mov $#2192 #0x0011
mov $#2193 #0x1100

; 'K' (ASCII 75)
mov $#2200 #0x0100
mov $#2201 #0x0100
mov $#2202 #0x0100
mov $#2203 #0x1000
mov $#2204 #0x0111
mov $#2205 #0x0000
mov $#2206 #0x0100
mov $#2207 #0x1000
mov $#2208 #0x0100
mov $#2209 #0x0100

; 'L' (ASCII 76)
mov $#2216 #0x0100
mov $#2217 #0x0000
mov $#2218 #0x0100
